# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ===== Experiment run outputs (regenerated by running the lab) =====
# CSV logs, run metadata and console logs are reproducible artifacts.
*.csv
*.meta.json
*.log

# ===== Generated plots (reproducible from CSVs via analysis/plot_attack.py) =====
analysis/*.png
detection/*.png

# ===== Keep the finalized dataset and figures used in the report =====
# This negation must come AFTER the ignore rules above.
!results/final/**

# ===== ML datasets & models (regenerable or large; keep ml/results/*.txt + assets/*.png) =====
ml/data/
ml/models/
*.pkl
*.joblib

# ===== PCAP captures + timelines (large; regenerated by experiments/capture_session.py) =====
detection/cap/
*.pcap
*.timeline

# ===== Dashboard (Node) =====
dashboard/node_modules/
dashboard/*.log
npm-debug.log*

# ===== Local tooling / IDE / editors =====
CLAUDE.md
claude.md
.claude/
.vscode/
.idea/
*.code-workspace

# ===== OS junk =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Temp / backup =====
*.tmp
*.bak
*~
